# Copy to .env.local. Keep the real key only in that ignored file or Vercel.
# Obtain your own key from https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Server-side model. Change to a Responses / structured-output model your account can use.
OPENAI_MODEL=gpt-6-luna
# Optional: image-input + structured-output model for listing screenshots.
# If empty, OPENAI_MODEL is used. Never use a NEXT_PUBLIC_/VITE_ prefix for secrets.
OPENAI_VISION_MODEL=
PORT=4173
